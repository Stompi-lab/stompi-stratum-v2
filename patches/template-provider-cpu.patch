+bool Sv2Connman::ShouldTryToSend(Id id) const
+{
+    AssertLockNotHeld(m_clients_mutex);
+
+    auto client{WITH_LOCK(m_clients_mutex, return GetClientById(id);)};
+    if (!client) return false;
+
+    LOCK(client->cs_send);
+    const auto& [data, more, message_type] =
+        client->m_transport->GetBytesToSend(/*have_next_message=*/!client->m_send_messages.empty());
+
+    // Include buffered Noise handshake bytes and partial sends. A queued
+    // message alone is insufficient while the transport awaits its peer.
+    return !data.empty() || more;
+}
